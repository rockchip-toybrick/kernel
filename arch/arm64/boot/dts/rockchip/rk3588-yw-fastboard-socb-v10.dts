/dts-v1/;

#include "dt-bindings/usb/pd.h"
#include "rk3588m.dtsi"
#include "rk3588-yw-v10.dtsi"
#include "rk3588-rk806-dual.dtsi"
#include "rk3588-android.dtsi"
#include "rk3588-yw-v10-socb-audio.dtsi"

/ {
	model = "Rockchip RK3588 YW FastBoard SoCB Board";
	compatible = "rockchip,rk3588-yw-fastboard-socb-v10", "rockchip,rk3588";

	chosen: chosen {
		bootargs = "earlycon=uart8250,mmio32,0xfeb50000 console=ttyFIQ0 irqchip.gicv3_pseudo_nmi=0 rcupdate.rcu_expedited=1 rcu_nocbs=all spidev.bufsiz=131072 default_hugepagesz=32M hugepagesz=32M hugepages=16";
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		bar0_region: bar0-region@3c000000 {
			reg = <0x0 0x3c000000 0x0 0x00400000>;
		};
		bar2_region: bar2-region@40000000 {
			reg = <0x0 0x40000000 0x0 0x04000000>;
		};
	};
